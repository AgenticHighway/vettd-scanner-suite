				},
				{
					"name": "Poll batch",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/scans/batch/{{batchId}}",
							"host": ["{{baseUrl}}"],
							"path": ["scans", "batch", "{{batchId}}"]
						},
						"description": "Self-loops via postman.setNextRequest until every accepted item reaches a terminal state (capped at 60 attempts, same delay-request requirement as Poll job: minimal)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const MAX_ATTEMPTS = 60;",
									"",
									"let attempts = parseInt(pm.collectionVariables.get(\"batchPollAttempts\") || \"0\", 10) + 1;",
									"pm.collectionVariables.set(\"batchPollAttempts\", String(attempts));",
									"",
									"pm.test(\"status 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"const body = pm.response.json();",
									"",
									"pm.test(\"batch id echoes request\", function () {",
									"    pm.expect(body.batchId).to.eql(pm.collectionVariables.get(\"batchId\"));",
									"});",
									"pm.test(\"no accepted entry carries a results key\", function () {",
									"    for (const entry of body.accepted) {",
									"        pm.expect(entry).to.not.have.property(\"results\");",
									"    }",
									"});",
									"pm.test(\"accepted statuses are known values\", function () {",
									"    const known = [\"queued\", \"running\", \"completed\", \"failed\", \"expired\"];",
									"    for (const entry of body.accepted) {",
									"        pm.expect(known).to.include(entry.status);",
									"    }",
									"});",
									"",
									"const pending = body.accepted.filter((a) => a.status === \"queued\" || a.status === \"running\");",
									"if (pending.length > 0) {",
									"    if (attempts < MAX_ATTEMPTS) {",
									"        postman.setNextRequest(pm.info.requestName);",
									"    } else {",
									"        pm.test(\"batch reached a terminal state within \" + MAX_ATTEMPTS + \" polls\", function () {",
									"            throw new Error(pending.length + \" item(s) still pending after \" + MAX_ATTEMPTS + \" polls\");",
									"        });",
									"    }",
									"}"
								]
							}
						}
					]
				}
			]
		},
