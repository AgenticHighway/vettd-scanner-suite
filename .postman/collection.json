						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status 202\", function () {",
									"    pm.response.to.have.status(202);",
									"});",
									"",
									"const body = pm.response.json();",
									"pm.test(\"response has jobId and queued status\", function () {",
									"    pm.expect(body.jobId).to.be.a(\"string\").and.not.empty;",
