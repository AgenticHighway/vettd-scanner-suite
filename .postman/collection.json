						"body": {
							"mode": "raw",
							"raw": "{\"items\":[{\"textFiles\":{\"SKILL.md\":\"# Skill\"},\"allPaths\":[\"SKILL.md\"]},{\"allPaths\":\"nope\"}]}"
						},
