							"raw": "{{baseUrl}}/scans/batch",
							"host": ["{{baseUrl}}"],
							"path": ["scans", "batch"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status 400\", function () {",
									"    pm.response.to.have.status(400);",
									"});",
									"",
									"pm.test(\"error mentions items must be an array\", function () {",
									"    const body = pm.response.json();",
									"    pm.expect(body.error).to.include(\"array\");",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "GET /scans/batch/:id, unknown batch -> 404",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/scans/batch/00000000-0000-0000-0000-000000000000",
							"host": ["{{baseUrl}}"],
							"path": ["scans", "batch", "00000000-0000-0000-0000-000000000000"]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"status 404\", function () {",
